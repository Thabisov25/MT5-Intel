[TEMPLATE]
# Copy to .env and fill in. Never commit .env.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_TERMINAL_PATH=
MT5_UTC_OFFSET_HOURS=
SYMBOL_ROOT=USDJPY
REFERENCE_EQUITY_ZAR=100
RISK_PCT=1
USD_ZAR_FALLBACK=18
HISTORY_BARS=300000
SPREAD_DAYS=30
TICK_WATCH_SECONDS=30
REPORT_DIR=reports

# Auto-trading. Leave all of these unset unless you want this process placing orders: an unset
# AUTO_TRADE means off, and the dashboard switch cannot arm anything while it is unset. Arming it
# also needs the account's normal (not investor) password, which is what gives MT5 the ability to
# fill an order at all.
#AUTO_TRADE=false
# Name only strategies that have a `historically validated` row for H1. `confluence` is the pair
# pattern: two or more allowed cards entering the same bar the same way, traded off the tightest of
# their stops. It needs the families it is made of to be listed here too.
# The fallback selection: what may trade when nothing has been saved on the Live tab's picker. A
# saved selection wins over this line for the strategies only - it can narrow this list, never widen
# the switches above it.
#AUTO_TRADE_STRATEGIES=
# The acknowledgement: trade a strategy research has NOT validated. Every position it opens is
# recorded as unvalidated, and the panel marks the row. Off, and such a name is refused.
#AUTO_TRADE_ALLOW_UNVALIDATED=false
#AUTO_TRADE_MAX_POSITIONS=2
#AUTO_TRADE_RISK_PCT=1
# A second switch, on purpose. Without it a REAL account is refused outright.
#AUTO_TRADE_ALLOW_REAL=false
#AUTO_TRADE_MAGIC=20261013
